# Copy this file to .env.local and fill in values from Supabase Project Settings → API.
# These are public browser-client values. Never place service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep the demo on mock data until a module has been deliberately migrated.
VITE_SUPABASE_INTEGRATION=disabled
