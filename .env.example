# Copy this file to .env.local and fill in values from Supabase Project Settings → API.
# These are public browser-client values. Never place service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted for existing deployments only.
VITE_SUPABASE_ANON_KEY=

# Finance uses the real Supabase client when URL + publishable key are present.
# Other modules remain on the mock adapter until migrated.
VITE_SUPABASE_INTEGRATION=finance
