# Copy this file to .env.local and supply values from Supabase Project Settings → API.
# Only browser-safe values belong here. NEVER use a service-role or secret key.
VITE_SUPABASE_URL=https://fpzcwetpcwswhxmyeqzh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy anon key is supported temporarily for existing deployments.
VITE_SUPABASE_ANON_KEY=

# Finance remains on its own integration switch.
VITE_SUPABASE_INTEGRATION=finance

# Congregation/member directory, transfers, ministries, and leadership use the
# live database independently of the other modules.
VITE_SUPABASE_MEMBER_INTEGRATION=enabled

# SCMS portal authentication uses real Supabase Auth.
VITE_SUPABASE_AUTH=enabled
